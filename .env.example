# Nisha production environment (root `.env` for docker-compose.prod.yml)
# Copy to `.env` on the VPS and fill real values. Never commit `.env`.

# --- Required ---
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Public frontend origin(s) for CORS (comma-separated if multiple)
CORS_ORIGINS=https://app.example.com

# Public URLs the browser / email links use
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com

# Email (production rejects EMAIL_PROVIDER=console)
EMAIL_PROVIDER=resend
EMAIL_FROM=Nisha <noreply@example.com>
RESEND_API_KEY=re_xxxxxxxx

# If EMAIL_PROVIDER=smtp instead of resend:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- Optional ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SMS_PROVIDER=console
# SMS_SENDER=
# KAVENEGAR_API_KEY=
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14
# STORAGE_BACKEND=local
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_PUBLIC_BASE_URL=
